mxGeometry x="2462" y="1043" width="40" height="40" as="geometry"/></mxCell><mxCell id="kc6" value="&lt;b&gt;Kion Connector · Custom&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;SaaS і on-prem: CSV / API&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4EE8;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2450" y="1105" width="320" height="60" as="geometry"/></mxCell><mxCell id="i96" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#232F3D;shape=mxgraph.aws4.gear;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2462" y="1115" width="40" height="40" as="geometry"/></mxCell><mxCell id="t97" value="Кластер: 3–6 × m6i.xlarge (ECS-optimized AL2023), Auto Scaling за CPU 60 %, мінімум 1 вузол у кожній AZ. Образи лише з ECR (scan on push + Tenable). На кожному вузлі: Zabbix agent2, Nessus agent, CloudWatch agent; IMDSv2 обов&amp;#x27;язковий; SSH закритий. Розгортання — rolling, без простою UI/API. Конектори працюють з черги Redis із повторними спробами та backoff; кожен конектор має окремі облікові дані з мінімальними правами." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#475467;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2110" y="1420" width="660" height="220" as="geometry"/></mxCell><mxCell id="z_egress" value="" style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1453B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#101828;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2820" y="680" width="910" height="300" as="geometry"/></mxCell><mxCell id="b98" value="Контрольований вихід · лише HTTPS 443" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D1453B;strokeColor=#D1453B;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2836" y="667" width="304" height="26" as="geometry"/></mxCell><mxCell id="x3" value="&lt;b&gt;NAT Gateway ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;EIP 203.0.113.12 / .13&lt;br&gt;по одному на AZ&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7F6F4;strokeColor=#0E9384;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2840" y="720" width="280" height="120" as="geometry"/></mxCell><mxCell id="i99" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#8C4FFF;shape=mxgraph.aws4.nat_gateway;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2852" y="760" width="40" height="40" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;AWS Network Firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;FQDN allowlist, TLS SNI&lt;br&gt;логи → Splunk&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FDEDEB;strokeColor=#D1453B;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" pare