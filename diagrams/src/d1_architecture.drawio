quot;font-size:11.5px;color:#475467&quot;&gt;щодня · копія в eu-west-1 · 35 днів&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=#B7791F;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3290" y="1224" width="425" height="60" as="geometry"/></mxCell><mxCell id="i109" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#7AA116;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3302" y="1234" width="40" height="40" as="geometry"/></mxCell><mxCell id="t110" value="CloudTrail організації пише всі API-виклики KionServiceRole в окремий log-archive акаунт. Доступ адміністраторів до вузлів ECS — лише через SSM Session Manager після активації ролі в Entra PIM; SSH (22) закритий у всіх Security Groups." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#475467;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2840" y="1430" width="870" height="160" as="geometry"/></mxCell><mxCell id="z_data" value="" style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#101828;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1730" y="1700" width="1060" height="360" as="geometry"/></mxCell><mxCell id="b111" value="Дані та секрети · шифрування KMS" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#B7791F;stroke