;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="1080" height="100" as="geometry"/></mxCell><mxCell id="i47" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#232F3D;shape=mxgraph.aws4.gear;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="82" y="790" width="40" height="40" as="geometry"/></mxCell><mxCell id="e_otrs" value="&lt;b&gt;OTRS HelpDesk + CMDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;запити, погодження, тікети, CI&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#C2410C;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="1080" height="110" as="geometry"/></mxCell><mxCell id="i48" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="82" y="935" width="40" height="40" as="geometry"/></mxCell><mxCell id="e_vault" value="&lt;b&gt;HashiCorp Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;секрети інтеграцій&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FDEDEB;strokeColor=#D1453B;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1050" width="1080" height="100" as="geometry"/></mxCell><mxCell id="i49" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="82" y="1080" width="40" height="40" as="geometry"/></mxCell><mxCell id="e_onprem" value="&lt;b&gt;On-prem витрати DC-1 / DC-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;CSV: обладнання, енергія, ліцензії&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F8F4EC;strokeColor=#8A6D3B;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1190" width="1080" height="100" as="geometry"/></mxCell><mxCell id="i50" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#7D8998;shape=mxgraph.aws4.corporate_data_center;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="82" y="1220" width="40" height="40" as="geometry"/></mxCell><mxCell id="e_splunk" value="&lt;b&gt;Splunk SIEM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;аудит, кореляція подій&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F4EEFC;strokeColor=#7A3EC8;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1330" width="1080" height="100" as="geometry"/></mxCell><mxCell id="i51" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="82" y="1360" width="40" height="40" as="geometry"/></mxCell><mxCell id="e_zabbix" value="&lt;b&gt;Zabbix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#475467&quot;&gt;доступність, свіжість даних&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F4EEFC;strokeColor=#7A3EC8;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#101828;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1470" width="1080" height="100" as="geometry"/></mxCell><mxCell id="i52" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fontFamily=Helvetica;fontSize=11;fontColor=#101828;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="82" y="1500" width="40" height="40" as="geometry"/></mxCell><mxCell id="t53" value="Зовнішні сутності TB2 — корпоративні системи компанії (1000 працівників, 2 Dev-центри). Користувачі заходять у Kion тільки з корпоративної мережі або Client VPN; автентифікація — у браузері через Entra ID (SAML 2.0 + MFA). OTRS є джерелом запитів на акаунти та бюджети і отримувачем тікетів від Kion; CMDB зберігає акаунти, сервіси та їх власників. GitHub зберігає Cloud Rules і Spend Plans як код: зміни проходять PR, рев&amp;#x27;ю двох осіб, quality gate SonarQube і RFC." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#475467;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="1600" width="1080" height="600" as="geometry"/></mxCell><mxCell id="z_kion" value="" style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4EE8;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#101828;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1240" y="520" width="2080" height="1700" as="geometry"/></mxCell><mxCell id="b54" value="TB4 · AWS акаунт kion-prod (довірена зона)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2A4EE8;strokeColor=#2A4EE8;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1256" y="507" width="341" height="26" as="geometry"/></mxCell><mxCell id="P1" value="&lt;b&gt;1.0 Edge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475467&quot;&gt;Internal ALB + WAF&lt;br&gt;TLS 1.2+&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E8F5EC;strokeColor=#188038;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#101828;spacing=14;" vertex="1" parent="1"><mxGeometry x="1300" y="580" width="210" height="210" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;2.0 Kion UI / REST API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475467&quot;&gt;SSO, RBAC,&lt;br&gt;дашборди&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E8F5EC;strokeColor=#188038;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#101828;spacing=14;" vertex="1" parent="1"><mxGeometry x="1650" y="580" width="210" height="210" as="geometry"/></mxCell><mxCell id="P8" value